proc vector toVec(float $f[]) {
    return <<$f[0], $f[1], $f[2]>>;
}

proc vector blendVec(vector $a, vector $b, float $t) {
    return $a + ($b - $a) * $t;
}

proc vector[] nearestPairOnLines(vector $aStart, vector $aEnd, vector $bStart, vector $bEnd) {
    vector $dirA = $aEnd - $aStart;
    vector $dirB = $bEnd - $bStart;
    vector $offset = $aStart - $bStart;
    float $aa = dot($dirA, $dirA);
    float $bb = dot($dirB, $dirB);
    float $ab = dot($dirA, $dirB);
    float $ao = dot($dirA, $offset);
    float $bo = dot($dirB, $offset);
    if ($aa < 1e-12 || $bb < 1e-12)
        error "One of the selected edges has zero length.";
    float $det = $aa * $bb - $ab * $ab;
    if ($det <= 1e-9 * $aa * $bb)
        error "The edges are parallel, so they have no single crossing point.";
    float $s = ($ab * $bo - $bb * $ao) / $det;
    float $t = ($aa * $bo - $ab * $ao) / $det;
    vector $result[];
    $result[0] = blendVec($aStart, $aEnd, $s);
    $result[1] = blendVec($bStart, $bEnd, $t);
    return $result;
}

proc string[] edgeEnds(string $edge) {
    string $raw[] = `polyListComponentConversion -fromEdge -toVertex $edge`;
    return `ls -flatten $raw`;
}

global proc weldEdgeCrossing() {
    string $picked[] = `filterExpand -selectionMask 32 -expand true`;
    if (size($picked) != 2)
        error "Select exactly two polygon edges.";

    string $partsA[];
    string $partsB[];
    tokenize $picked[0] "." $partsA;
    tokenize $picked[1] "." $partsB;
    int $sameMesh = ($partsA[0] == $partsB[0]);
    if (!$sameMesh)
        warning "The edges are on different meshes, so the vertices will be aligned but not merged.";

    string $vertsA[] = edgeEnds($picked[0]);
    string $vertsB[] = edgeEnds($picked[1]);
    vector $a0 = toVec(`pointPosition -world $vertsA[0]`);
    vector $a1 = toVec(`pointPosition -world $vertsA[1]`);
    vector $b0 = toVec(`pointPosition -world $vertsB[0]`);
    vector $b1 = toVec(`pointPosition -world $vertsB[1]`);

    vector $hits[] = nearestPairOnLines($a0, $a1, $b0, $b1);
    vector $target = blendVec($hits[0], $hits[1], 0.5);

    string $vertA = (mag($hits[0] - $a0) < mag($hits[0] - $a1)) ? $vertsA[0] : $vertsA[1];
    string $vertB = (mag($hits[1] - $b0) < mag($hits[1] - $b1)) ? $vertsB[0] : $vertsB[1];

    undoInfo -openChunk -chunkName "weldEdgeCrossing";
    move -absolute -worldSpace ($target.x) ($target.y) ($target.z) $vertA;
    if ($vertB != $vertA)
        move -absolute -worldSpace ($target.x) ($target.y) ($target.z) $vertB;
    if ($sameMesh && $vertA != $vertB)
        polyMergeVertex -alwaysMergeTwoVertices true $vertA $vertB;
    undoInfo -closeChunk;
}

weldEdgeCrossing();
